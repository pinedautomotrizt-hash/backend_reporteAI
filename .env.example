# Copia este archivo como .env y ajusta los valores
PORT=4000
NODE_ENV=development
# URL(s) del frontend permitidas para CORS, separadas por coma
FRONTEND_URL=http://localhost:5180

# Sistema de Control de Personal (de aquí se leen las OTs)
# Recomendado: un usuario exclusivo para esta integración, con permisos de solo lectura
CONTROL_PERSONAL_URL=https://controlpersonalback-production.up.railway.app
CONTROL_PERSONAL_EMAIL=
CONTROL_PERSONAL_PASSWORD=

# Firma de los tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Roles de Control de Personal que entran como JEFE DE TALLER (separados por coma).
# Los técnicos se detectan solos por /api/tecnicos.
ROLES_JEFE=admin

# MySQL. En Railway usa la referencia del plugin: DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://root:@127.0.0.1:3306/taller_reportes

# Carpeta de fotos. En Railway: la ruta donde montes el Volume, p.ej. /data/uploads
STORAGE_DIR=./uploads

# IA para redactar informes: Google Gemini (la misma clave que usa Control de Personal).
# Vacío = el informe se arma con el texto del técnico, sin IA.
GEMINI_API_KEY=
GEMINI_MODELOS=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.5-flash-lite

# Firma y responsable que aparecen en el informe
INFORME_JEFE_NOMBRE=ING. NIXON A. QUISPE ACOSTA
INFORME_JEFE_CARGO=Jefe de taller - Trujillo
INFORME_RESPONSABLE=Nixon Quispe
